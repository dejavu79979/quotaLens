{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    // "node" is here for the `tsx --test` files under src/ (same runner as daemon and shared);
    // the app code itself only uses browser globals.
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    // The Vite template ships without it, but daemon and shared are strict and §3 leans on
    // `string | null` everywhere (resetsAt, fetchedAt, every window). Without strict the plugin
    // would silently lose exactly the null-safety the contract is built on.
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
